{
  "name": "pr-tools-notifier",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram notifications for gh-pr-tools",
  "type": "module",
  "bin": {
    "pr-tools-notifier": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "check": "prettier --check .",
    "fix": "prettier --write .",
    "type:check": "tsc --noEmit",
    "compile": "tsc -p tsconfig.build.json",
    "build": "pnpm run compile",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "prettier": "3.3.3",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  }
}
